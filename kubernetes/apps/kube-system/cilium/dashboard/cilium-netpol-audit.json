      "title": "Overview — Accounted vs Unaccounted Policy Verdicts",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Percentage of forwarded ingress policy verdicts matched by an explicit CiliumNetworkPolicy rule (l3-l4, l3-only, l4-only) vs falling through to default-allow (match=all).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Ingress Policy Coverage",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "100 * (sum(increase(hubble_policy_verdicts_total{direction=\"ingress\", destination_namespace=~\"$namespace\", match=~\"l3-l4|l3-only|l4-only\"}[$__range])) or vector(0)) / clamp_min(sum(increase(hubble_policy_verdicts_total{direction=\"ingress\", destination_namespace=~\"$namespace\", action=\"forwarded\"}[$__range])), 1)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
